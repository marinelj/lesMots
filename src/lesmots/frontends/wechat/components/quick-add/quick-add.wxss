.qa-bar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; gap: 16rpx; align-items: center;
  padding: 16rpx 24rpx; background: #f8fafc;
  border-bottom: 2rpx solid #e2e8f0;
}
.qa-input {
  flex: 1; background: #fff; border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  padding: 14rpx 20rpx; font-size: 30rpx;
}
.qa-btn { background: #4f46e5; color: #fff; border-radius: 12rpx; }
.qa-btn[disabled] { background: #c7d2fe; color: #fff; }
