<view class="qa-bar">
  <input class="qa-input" placeholder="添加生词，如 bonjour" value="{{draft}}"
         bindinput="onDraft" bindconfirm="addWord" confirm-type="done"
         disabled="{{adding}}" />
  <button class="qa-btn" size="mini" bindtap="addWord"
          loading="{{adding}}" disabled="{{adding || !draft}}">存入</button>
</view>
