.page { padding: 24rpx; }

.section-head { font-size: 32rpx; font-weight: 600; color: #0f172a; }
.section-sub { margin: 8rpx 0 24rpx; font-size: 25rpx; color: #64748b; }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 28rpx; }
.chip {
  background: #eef2ff; color: #4f46e5; border-radius: 999rpx;
  padding: 10rpx 24rpx; font-size: 26rpx;
}
.chip-x { margin-left: 6rpx; color: #94a3b8; }

.add-row { display: flex; gap: 16rpx; align-items: center; margin-bottom: 28rpx; }
.add-input {
  flex: 1; background: #fff; border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 30rpx;
}
.add-btn { background: #4f46e5; color: #fff; border-radius: 12rpx; }
.add-btn[disabled] { background: #c7d2fe; color: #fff; }

.save { background: #4f46e5; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.save-idle, .save[disabled] { background: #e2e8f0; color: #64748b; }

.lang { margin-top: 32rpx; text-align: center; font-size: 25rpx; color: #94a3b8; }
.hint { color: #64748b; font-size: 26rpx; }
.error { padding: 0 0 16rpx; color: #dc2626; font-size: 26rpx; }
