.page { padding: 24rpx; }

.hero { padding: 96rpx 32rpx; text-align: center; }
.hero-title { font-size: 38rpx; font-weight: 600; color: #0f172a; }
.hero-sub { margin: 20rpx 0 48rpx; font-size: 27rpx; color: #64748b; line-height: 1.6; }

.primary { background: #4f46e5; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.primary[disabled] { background: #c7d2fe; color: #fff; }
.ghost {
  background: #fff; color: #4f46e5; border: 2rpx solid #c7d2fe;
  border-radius: 12rpx; font-size: 28rpx;
}
.ghost[disabled] { color: #94a3b8; border-color: #e2e8f0; }

.story-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.06);
}
.story-src { font-size: 24rpx; color: #64748b; margin-bottom: 16rpx; }
.story-text { font-size: 30rpx; color: #1e293b; line-height: 1.8; }

/* bank-word highlights — same familiarity scale as the web UI (fam1-5) */
.fam { border-radius: 6rpx; padding: 0 6rpx; font-weight: 600; }
.fam-0 { background: #eef2ff; color: #4f46e5; }  /* not in bank map */
.fam-1 { background: #ef4444; color: #ffffff; }
.fam-2 { background: #f97316; color: #ffffff; }
.fam-3 { background: #eab308; color: #422006; }
.fam-4 { background: #84cc16; color: #1a2e05; }
.fam-5 { background: #22c55e; color: #052e16; }

.chips { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  background: #eef2ff; color: #4f46e5; border-radius: 999rpx;
  padding: 6rpx 20rpx; font-size: 24rpx;
}

.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.actions button { margin: 0; }
.grow { flex: 1; }

.loved { margin-top: 48rpx; }
.loved-head { font-size: 28rpx; font-weight: 600; color: #0f172a; margin-bottom: 16rpx; }
.loved-card {
  background: #fff; border-radius: 16rpx; padding: 22rpx 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.06);
}
.loved-title {
  font-size: 28rpx; color: #1e293b; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
.loved-meta { margin-top: 6rpx; font-size: 24rpx; color: #64748b; }
.loved-body {
  margin-top: 14rpx; padding-top: 14rpx; border-top: 2rpx solid #f1f5f9;
  font-size: 28rpx; color: #334155; line-height: 1.7;
}

.hint { padding: 16rpx; color: #64748b; text-align: center; font-size: 26rpx; }
.foot { padding: 8rpx; }
.error { padding: 16rpx 24rpx; color: #dc2626; font-size: 26rpx; }
