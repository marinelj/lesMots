<quick-add bind:wordadded="onWordAdded" />
<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{!words.length}}" class="hint">
    词库还是空的 — 存入第一个词，利息从今天开始算。
  </view>

  <view wx:for="{{words}}" wx:key="text" class="word-card"
        bindtap="toggleExpand" data-text="{{item.text}}"
        bindlongpress="confirmRemove" data-index="{{index}}">
    <view class="word-head">
      <text class="word-text">{{item.text}}</text>
      <text class="word-fam">{{item.stars}}</text>
    </view>
    <view class="word-meta">{{item.language}} · 复习 {{item.reviews}} 次</view>
    <view wx:if="{{expanded === item.text}}" class="word-expl">{{item.explanation}}</view>
  </view>

  <view wx:if="{{words.length}}" class="hint foot">轻点看释义 · 长按删除</view>
</view>
