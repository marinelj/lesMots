# Copy to ~/.lexrender/env (chmod 600). Never commit the real file.
LEXRENDER_PUBLIC_URL=https://marine-api.tunnel.tungo.cn/lesmots
LEXRENDER_DB=$HOME/.lexrender/lexicon.db
# Must be the same value the LesMots app signs sessions with, or no sign-in token will verify.
LESMOTS_SESSION_SECRET=<ask Marine; do not paste it anywhere else>
# Optional, for remote render (paid plan):
# ANTHROPIC_API_KEY=
